# =============================================================================
# Backend — merged Module 1 + Module 2 app
# Scoped to this folder, matching module1/.gitignore and module2/.gitignore.
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd

# --- Virtual environment ---
venv/
.venv/
env/

# --- Demo user data (runtime state, created on first sign-in) ---
# users.json is the demo's user registry and data/users/<slug>/ holds each
# person's profile, preferences, workout log and recommendation history. All of
# it is generated by backend/user_store.py and is per-machine — committing it
# would mean every sign-in and every logged workout shows up as a diff.
data/
