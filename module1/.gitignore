# =============================================================================
# Data Files — Large / Generated
# Keep folder structure via .gitkeep but ignore actual data files
# =============================================================================

# Raw videos (large — store on external drive or cloud)
data/raw_videos/*.mp4
data/raw_videos/*.avi
data/raw_videos/*.mov
data/raw_videos/*.mkv
data/raw_videos/*.webm
data/raw_videos/null_clips/

# Legacy sample_videos folder
data/sample_videos/*.mp4
data/sample_videos/*.avi
data/sample_videos/*.mov
data/sample_videos/*.mkv
data/sample_videos/*.webm

# Extracted landmark CSVs (large — regenerate from raw video + app.py)
data/landmarks/*.csv
outputs/landmarks.csv
outputs/*.csv

# Annotation CSVs (TRACKED — small text files, represent your labeling work)
# Do NOT add data/annotations/ here

# Split label index CSVs (TRACKED — small, reproducible from annotations)
# Do NOT add data/labels/ here

# Saved NumPy window arrays (large binary — regenerate from dataset script)
data/windows/all/*.npy
data/windows/train/*.npy
data/windows/val/*.npy
data/windows/test/*.npy

# =============================================================================
# Model Checkpoints (large binary files — use Git LFS or cloud storage)
# =============================================================================
# models/
# *.pt
*.pth
*.ckpt
*.h5
*.pkl
*.joblib

