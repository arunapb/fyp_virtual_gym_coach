# ──────────────────────────────────────────────────────────────────
# NutriIngredientNet  — environment settings EXAMPLE
# Copy this file to .env and fill in your values.
# Real environment variables (e.g. from a hosting platform) always
# take precedence over values set here.
# ──────────────────────────────────────────────────────────────────

# ── Hugging Face model repository ─────────────────────────────────
# Public repo — no token required.
HF_REPO=arunapb/nutriingredientnet-v6

# Personal access token — only needed if HF_REPO is private.
# Generate one at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Inference options ──────────────────────────────────────────────
# Enable 4-rotation test-time augmentation (improves accuracy, ~4× slower)
USE_TTA=true

# Enable pseudo-depth channel via Depth Anything V2
# Set to false to skip depth model download and use a neutral channel instead
USE_DEPTH=true

# ── Upload limits ──────────────────────────────────────────────────
# Maximum allowed upload size in megabytes
MAX_UPLOAD_MB=15

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all
CORS_ORIGINS=*

# ── Device ─────────────────────────────────────────────────────────
# auto  → use CUDA if available, else CPU
# cuda  → force GPU (will error if unavailable)
# cpu   → force CPU
DEVICE=auto
